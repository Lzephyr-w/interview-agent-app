# Shared secret with Java; generate a random value and use the same value in server/.env.local.
AGENT_INTERNAL_KEY=replace-with-a-long-random-secret
AGENT_HOST=127.0.0.1
AGENT_PORT=8090
JAVA_AGENT_TOOL_URL=http://localhost:8080/internal/agent/tools
# OpenAI-compatible chat completions endpoint, server-side only.
AGENT_MODEL_API_URL=https://ai-provider.invalid/v1/chat/completions
AGENT_MODEL_API_KEY=replace-with-agent-model-key
AGENT_MODEL=replace-with-agent-model-name
