APP_CORS_ALLOWED_ORIGIN=http://localhost:3000
# 大于 5 MB 的录音需要服务端安装 FFmpeg；可填 FFmpeg 可执行文件路径，默认从 PATH 查找。
FFMPEG_PATH=ffmpeg
SUPABASE_URL=https://your-project-ref.supabase.co
# 数据库仅服务端使用；生产环境必须启用 TLS，不要提交真实密码。
SPRING_DATASOURCE_URL=jdbc:postgresql://db-host.invalid:5432/postgres?sslmode=require&currentSchema=interview_agent
SPRING_DATASOURCE_USERNAME=app_user
SPRING_DATASOURCE_PASSWORD=replace-with-secret
# 可选的 schema 覆盖；PostgreSQL 会优先自动读取 JDBC URL 中的 currentSchema，H2 自动使用 PUBLIC。
# APP_DATABASE_SCHEMA=interview_agent
# 仅当 Supabase JWT Keys 使用 Legacy HS256 时设置；否则留空并使用 JWKS。
SUPABASE_JWT_SECRET=replace-with-secret-or-empty
# ES256 网络受限时可固定公开 JWK；签名密钥轮换后同步更新。
SUPABASE_JWT_JWK_KID=replace-with-public-key-id-or-empty
SUPABASE_JWT_JWK_X=replace-with-public-coordinate-or-empty
SUPABASE_JWT_JWK_Y=replace-with-public-coordinate-or-empty
# 仅服务端访问私有 Storage bucket；前端不得配置该值。
SUPABASE_STORAGE_URL=https://your-project-ref.supabase.co/storage/v1
SUPABASE_STORAGE_SERVICE_KEY=replace-with-service-role-key
SUPABASE_RESUME_FILES_BUCKET=resume-files
SUPABASE_AI_MOCK_AUDIO_BUCKET=ai-mock-audio
# OpenAI 兼容 AI 服务，仅服务端使用。
AI_REVIEW_API_URL=https://ai-provider.invalid/v1/chat/completions
AI_REVIEW_API_KEY=replace-with-model-key
AI_REVIEW_MODEL=replace-with-model-name
# 复盘单次模型请求超时（秒）。
AI_REVIEW_TIMEOUT_SECONDS=240
# 腾讯云录音文件识别；共享默认引擎供 AI 语音模拟使用，仅服务端使用。
TENCENT_CLOUD_SECRET_ID=replace-with-tencent-secret-id
TENCENT_CLOUD_SECRET_KEY=replace-with-tencent-secret-key
TENCENT_CLOUD_REGION=ap-shanghai
TENCENT_CLOUD_ASR_ENGINE_MODEL_TYPE=16k_zh
# Python Agent internal service; use the same random secret in agent/.env.local.
AGENT_SERVICE_URL=http://localhost:8090
AGENT_INTERNAL_KEY=replace-with-a-long-random-secret

# 真实面试录音导入独立覆盖；留空沿用共享默认，不影响 AI 语音模拟。
# 可显式选 16k_zh_en_2.0 或适合多人对话的 16k_zh_en_meeting；不同引擎费用不同，先确认腾讯云计费。
INTERVIEW_IMPORT_ASR_ENGINE=
# 可选临时热词，英文逗号分隔，最多128项；词最多30字符/10汉字，权重1–11。
# 权重100仅16k_zh支持且会强制同音替换，慎用；这里不默认启用。
# INTERVIEW_IMPORT_ASR_HOTWORDS=JavaScript|5,TypeScript|5,Vue|5,React|5,Node.js|5,Axios|5,Base64|5
INTERVIEW_IMPORT_ASR_HOTWORDS=
INTERVIEW_IMPORT_AI_TIMEOUT_SECONDS=180
INTERVIEW_IMPORT_AI_BUDGET_SECONDS=900
